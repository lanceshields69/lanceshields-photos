---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// Map coverImage public paths to imported assets
const coverModules = import.meta.glob('../assets/images/*/000-cover.jpg', { eager: true }) as Record<string, { default: ImageMetadata }>;
const coverLookup: Record<string, ImageMetadata> = {};
for (const [filepath, mod] of Object.entries(coverModules)) {
  const slug = filepath.split('/').slice(-2, -1)[0];
  coverLookup[`/images/${slug}/000-cover.jpg`] = mod.default;
}
---

<BaseLayout title="All Projects" description="All photography projects by Lance Shields.">
  <div class="section" style="padding-top: 0">
    <div class="wrap">
      <div class="section-header">
        <h1>All Projects</h1>
      </div>

      <div class="all-projects-grid">
        {projects.map((project) => (
          <a href={`/${project.id}`} class="all-project-card">
            {
              coverLookup[project.data.coverImage] ? (
                <Image
                  src={coverLookup[project.data.coverImage]}
                  alt={project.data.title}
                  widths={[400, 800, 1200]}
                  sizes="(max-width: 768px) 100vw, 50vw"
                  format="avif"
                  quality={85}
                  loading="lazy"
                />
              ) : (
                <img
                  src={project.data.coverImage}
                  alt={project.data.title}
                  loading="lazy"
                  width="600"
                  height="450"
                />
              )
            }
            <div class="all-project-title">{project.data.title}</div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>