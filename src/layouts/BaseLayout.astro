---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Lance Shields Photography — lens-based artist living in San Francisco.',
  ogImage = '/images/og-default.jpg',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} - Lance Shields Photography</title>
  <meta name="description" content={description} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${title} - Lance Shields Photography`} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" type="image/svg+xml" href="/images/camera-favicon.svg" />
  <link rel="stylesheet" href="https://use.typekit.net/ljg3lbn.css" />
</head>
<body>
  <div class="mobile-header">
    <a href="/" class="mobile-logo">
      <img src="/camera-icon.svg" alt="" width="29" height="31" />
      <span>Lance Shields<br>Photography</span>
    </a>
    <button class="hamburger" id="hamburger" aria-label="Menu">
      <img src="/images/menu-icon.svg" alt="" width="30" height="30" id="hamburger-icon" />
    </button>
  </div>
  <div class="site-layout">
    <aside class="site-sidebar">
      <div class="sidebar-inner">
        <a href="/" class="nav-brand">
            <img src="/camera-icon.svg" alt="" class="brand-icon" width="38" height="42" />
            <span>Lance Shields<br>Photography</span>
          </a>

        <nav class="sidebar-nav">
          <div class="nav-section">
            <button class="nav-dropdown-toggle" id="work-toggle" aria-expanded="false">Selected Work ▾</button>
            <ul class="nav-dropdown-menu" id="work-menu" hidden>
              <li><a href="/strange-nature" class:list={[{ active: currentPath === '/strange-nature' }]}>Strange Nature</a></li>
              <li><a href="/fragments" class:list={[{ active: currentPath === '/fragments' }]}>Fragments</a></li>
              <li><a href="/nothing-with-a-name" class:list={[{ active: currentPath === '/nothing-with-a-name' }]}>Nothing with a Name</a></li>
              <li><a href="/surface-tension" class:list={[{ active: currentPath === '/surface-tension' }]}>Surface Tension</a></li>
              <li><a href="/remembering-seal-rock" class:list={[{ active: currentPath === '/remembering-seal-rock' }]}>Remembering Seal Rock</a></li>
              <li><a href="/eighty-sixed-in-la" class:list={[{ active: currentPath === '/eighty-sixed-in-la' }]}>Eighty-Sixed in LA</a></li>
              <li><a href="/we-got-seoul" class:list={[{ active: currentPath === '/we-got-seoul' }]}>We Got Seoul</a></li>
              <li><a href="/return-to-tokyo" class:list={[{ active: currentPath === '/return-to-tokyo' }]}>Return to Tokyo</a></li>
              <li><a href="/painted-in-kyoto" class:list={[{ active: currentPath === '/painted-in-kyoto' }]}>Painted in Kyoto Light</a></li>
              <li><a href="/chromatic-shift" class:list={[{ active: currentPath === '/chromatic-shift' }]}>Chromatic Shift</a></li>
              <li><a href="/up-close" class:list={[{ active: currentPath === '/up-close' }]}>Way Up Close</a></li>
              <li><a href="/mission-st-song" class:list={[{ active: currentPath === '/mission-st-song' }]}>Song of Mission St</a></li>
            </ul>
          </div>
          <a href="/about" class="nav-link" class:list={[{ active: currentPath === '/about' }]}>About</a>
          <a href="/videos" class="nav-link" class:list={[{ active: currentPath === '/videos' }]}>Videos</a>
          <a href="/photo-zines" class="nav-link" class:list={[{ active: currentPath === '/photo-zines' }]}>Photo zines</a>
        </nav>

        <div class="sidebar-footer">
          <span>Lance Shields &copy; All rights reserved</span>
          <a href="https://www.instagram.com/lanceshields.photos/" target="_blank" rel="noopener">
            <img src="/images/instagram.svg" alt="Instagram" width="24" height="24" />
          </a>
        </div>
      </div>
    </aside>

    <main class="site-main">
      <slot />
    </main>
  </div>

  <script>
    const toggle = document.getElementById('work-toggle');
    const menu = document.getElementById('work-menu');
    toggle?.addEventListener('click', () => {
      const open = menu?.hidden;
      if (menu) menu.hidden = !menu.hidden;
      toggle.setAttribute('aria-expanded', String(open));
    });
    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (menu && !menu.hidden && !toggle?.contains(e.target) && !menu.contains(e.target)) {
        menu.hidden = true;
        toggle?.setAttribute('aria-expanded', 'false');
      }
    });

    // Hamburger
    const hamburger = document.getElementById('hamburger');
    const sidebar = document.querySelector('.site-sidebar');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    hamburger?.addEventListener('click', () => {
      const isOpen = sidebar?.classList.toggle('open');
      if (hamburgerIcon) {
        hamburgerIcon.src = isOpen ? '/images/close.svg' : '/images/menu-icon.svg';
      }
    });

    // Swipe to close sidebar
    let touchStartX = 0;
    sidebar?.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
    }, { passive: true });
    sidebar?.addEventListener('touchmove', (e) => {
      const dx = e.touches[0].clientX - touchStartX;
      if (dx < -40) {
        sidebar.classList.remove('open');
        if (hamburgerIcon) hamburgerIcon.src = '/images/menu-icon.svg';
      }
    }, { passive: true });
  </script>
</body>
</html>