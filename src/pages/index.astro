---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import Carousel from '../components/Carousel.astro';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// Import slideshow images (sorted: 00.jpg, 01.jpg, ...)
const slideshowModules = import.meta.glob('../assets/images/slideshow/*.jpg', { eager: true }) as Record<string, { default: ImageMetadata }>;
const slideshowImages = Object.entries(slideshowModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default);

// Map coverImage public paths to imported assets for featured grid
const coverModules = import.meta.glob('../assets/images/*/000-cover.jpg', { eager: true }) as Record<string, { default: ImageMetadata }>;
const coverLookup: Record<string, ImageMetadata> = {};
for (const [filepath, mod] of Object.entries(coverModules)) {
  const slug = filepath.split('/').slice(-2, -1)[0];
  coverLookup[`/images/${slug}/000-cover.jpg`] = mod.default;
}
---

<BaseLayout title="Home" description="Lance Shields Photography — lens-based artist living in San Francisco.">
  <div class="wrap">
    <Carousel images={slideshowImages} />
  </div>

  <section class="section home-projects">
    <div class="wrap">
      <div class="section-header">
        <h2>Recent Projects</h2>
      </div>

      <div class="featured-grid">
        {
          projects.map((project) => (
            <div class="project-card">
              <a href={`/${project.id}`} class="featured-image">
                {
                  coverLookup[project.data.coverImage] ? (
                    <Image
                      src={coverLookup[project.data.coverImage]}
                      alt={project.data.title}
                      widths={[400, 800, 1200]}
                      sizes="(max-width: 768px) 100vw, 50vw"
                      format="avif"
                      quality={85}
                      loading="lazy"
                    />
                  ) : (
                    <img
                      src={project.data.coverImage}
                      alt={project.data.title}
                      loading="lazy"
                      width="482"
                      height="482"
                    />
                  )
                }
              </a>
              <div class="featured-text">
                <h3>{project.data.title}</h3>
                <p>{project.data.description}</p>
                <a href={`/${project.id}`} class="view-link">View project</a>
              </div>
            </div>
          ))
        }
      </div>

      <a href="/all-projects" class="all-projects-link">All projects</a>
</div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="video-module">
        <div class="video-embed">
          <iframe
            src="https://www.youtube.com/embed/hl5iLDLIB6U"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
        <p class="video-caption">SF Artists Alumni Spotlight: an artist talk on June 2, 2025, between myself, the curator Beth Waldman, and photographic artist Anni Lopponen from the Metaphors of Recent Times photo exhibit.</p>
      </div>
    </div>
  </section>
</BaseLayout>
