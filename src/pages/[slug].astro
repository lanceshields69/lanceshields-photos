---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import sharp from 'sharp';
import path from 'path';

// Global image optimization — eager import all project source images at build time
const allImageModules = import.meta.glob('../assets/images/*/*.{jpg,jpeg,png}', { eager: true }) as Record<string, { default: ImageMetadata }>;

// Group imported images by project slug
const projectImageLookup: Record<string, Record<string, ImageMetadata>> = {};
for (const [filepath, mod] of Object.entries(allImageModules)) {
  const parts = filepath.split('/');
  const slug = parts[parts.length - 2];
  const filename = parts[parts.length - 1];
  if (!projectImageLookup[slug]) projectImageLookup[slug] = {};
  projectImageLookup[slug][filename] = mod.default;
}

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, description, photos, videos, textAfter } = project.data;
const bodyText = project.body;
const slug = project.id;

// Split body text on <!--split--> marker
const splitIdx = bodyText.indexOf('<!--split-->');
const textPart1 = splitIdx > 0 ? bodyText.slice(0, splitIdx).trim() : bodyText;
const textPart2 = splitIdx > 0 ? bodyText.slice(splitIdx + 13).trim() : '';

// Lookups for the current project (empty for projects without assets)
const imgLookup = projectImageLookup[slug] || {};

// Precompute average colors for this project's placeholders
const colorLookup: Record<string, string> = {};
const assetsDir = path.join(process.cwd(), `src/assets/images/${slug}`);
if (Object.keys(imgLookup).length > 0) {
  for (const filename of Object.keys(imgLookup)) {
    const buf = await sharp(path.join(assetsDir, filename)).resize(1, 1).ensureAlpha().raw().toBuffer();
    colorLookup[filename] = '#' + [...buf.slice(0, 3)].map((c: number) => c.toString(16).padStart(2, '0')).join('');
  }
}

// Pre-generate lightbox-quality (2000px, quality 90) URLs for this project
const lightboxSrcMap: Record<string, string> = {};
for (const photo of photos) {
  const filename = photo.split('/').pop()!;
  const img = imgLookup[filename];
  if (img) {
    const optimized = await getImage({ src: img, width: 2000, quality: 90, format: 'avif' });
    lightboxSrcMap[filename] = optimized.src;
  }
}

// Build a merged list of gallery items: photos + videos at correct positions
const galleryItems: { type: 'photo' | 'video'; index: number; src?: string; url?: string; imageMeta?: ImageMetadata; lightboxSrc?: string; bgColor?: string }[] = [];
photos.forEach((photo, i) => {
  const filename = photo.split('/').pop()!;
  const imgMeta = imgLookup[filename];
  const bgColor = imgMeta ? (colorLookup[filename] || undefined) : undefined;
  galleryItems.push({
    type: 'photo',
    index: i,
    src: imgMeta ? undefined : photo,
    imageMeta: imgMeta,
    lightboxSrc: imgMeta ? (lightboxSrcMap[filename] || undefined) : undefined,
    bgColor,
  });
  // Insert videos after this photo index
  videos?.forEach((v) => {
    if (v.after === i) galleryItems.push({ type: 'video', index: i, url: v.url });
  });
});
---

<BaseLayout title={title} description={description}>
  <div class="project-page">
    <div class="gallery-scroll" id="gallery">
      <div class="gallery-track">
        {galleryItems.map((item, i) => (
          <>
            {item.type === 'photo' && (item.imageMeta || item.src) && (
              <div class="gallery-item" data-index={i} data-lightbox-src={item.lightboxSrc}>
                <span class="gallery-image-bg" style={item.bgColor ? `background-color:${item.bgColor}` : undefined}>
                {item.imageMeta ? (
                  <Image
                    src={item.imageMeta}
                    alt={`${title} photograph`}
                    widths={[400, 800, 1200, 1600]}
                    sizes="(max-width: 768px) 100vw, 80vw"
                    format="avif"
                    quality={85}
                    loading={i < 2 ? 'eager' : 'lazy'}
                  />
                ) : (
                  <img
                    src={item.src}
                    alt={`${title} photograph`}
                    loading={i < 2 ? 'eager' : 'lazy'}
                  />
                )}
                </span>
              </div>
            )}
            {item.type === 'video' && item.url && (
              <div class="gallery-video">
                <iframe
                  src={item.url}
                  title={`${title} video`}
                  frameborder="0"
                  allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
                  allowfullscreen
                ></iframe>
              </div>
            )}
            {item.type === 'photo' && item.index === 1 && (
              <div class="gallery-text-card">
                <h1>{title}</h1>
                <p>{textPart1}</p>
              </div>
            )}
            {item.type === 'photo' && textAfter?.includes(item.index) && (
              <div class="gallery-text-card">
                <p>{textPart2}</p>
              </div>
            )}
          </>
        ))}
      </div>

      

      <div class="gallery-progress">
        <div class="gallery-progress-bar" id="gallery-progress-bar"></div>
      </div>
    </div>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox" hidden>
      <div class="lightbox-bg"></div>
      <button class="lightbox-close" id="lightbox-close" aria-label="Close">&times;</button>
      <button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous">
        <img src="/images/left-arrow.svg" alt="" width="17" height="30" />
      </button>
      <button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next">
        <img src="/images/right-arrow.svg" alt="" width="17" height="30" />
      </button>
      <div class="lightbox-image-wrap">
        <img id="lightbox-img" alt="" />
      </div>
      <div class="lightbox-counter" id="lightbox-counter"></div>
    </div>
  </div>
</BaseLayout>

<script>
  (function () {
    const gallery = document.getElementById('gallery');
    const track = gallery?.querySelector('.gallery-track');
    if (!gallery || !track) return;

    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    const bar = document.getElementById('gallery-progress-bar');
    const items = gallery.querySelectorAll('.gallery-item');
    const photos = [...items].map(el => el.dataset.lightboxSrc || el.querySelector('img')?.src || '').filter(Boolean);

    // Fade-in images over color placeholders on load
    items.forEach(el => {
      const img = el.querySelector('img');
      if (!img) return;
      if (img.complete) { img.classList.add('is-loaded'); return; }
      img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
      img.addEventListener('error', () => img.classList.add('is-loaded'), { once: true });
    });

    function update() {
      const scrollLeft = gallery.scrollLeft;
      const maxScroll = gallery.scrollWidth - gallery.clientWidth;
      const pct = maxScroll > 0 ? (scrollLeft / maxScroll) * 100 : 0;
      if (bar) bar.style.width = pct + '%';
    }

    function scrollBy(dir) {
      const itemWidth = items[0]?.offsetWidth || gallery.clientWidth * 0.8;
      gallery.scrollBy({ left: dir * itemWidth, behavior: 'smooth' });
    }

    // Horizontal-scroll interactivity (desktop only; mobile is vertical)
    if (!isMobile) {
      // Cursor-based: click left/right half to scroll (but not on images)
      gallery.addEventListener('click', (e) => {
        if (e.target.tagName === 'IMG') return;
        const rect = gallery.getBoundingClientRect();
        const x = e.clientX - rect.left;
        if (x < rect.width / 2) scrollBy(-1);
        else scrollBy(1);
      });

      // Cursor: default on images, arrows in gaps
      gallery.addEventListener('mousemove', (e) => {
        if (e.target.tagName === 'IMG' || e.target.closest('.gallery-text-card')) {
          gallery.style.cursor = 'default';
          return;
        }
        const rect = gallery.getBoundingClientRect();
        const x = e.clientX - rect.left;
        gallery.style.cursor = x < rect.width / 2 ? 'url(/images/left-arrow.svg) 8 15, w-resize' : 'url(/images/right-arrow.svg) 8 15, e-resize';
      });

      // Wheel → horizontal scroll
      gallery.addEventListener('wheel', (e) => {
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) return; // natural horizontal already
        e.preventDefault();
        gallery.scrollBy({ left: e.deltaY, behavior: 'auto' });
      }, { passive: false });
    }

    gallery.addEventListener('scroll', update, { passive: true });

    // ---- Lightbox ----
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');
    const lightboxCount = document.getElementById('lightbox-counter');
    const lightboxBg = lightbox?.querySelector('.lightbox-bg');
    let lightboxIndex = 0;

    function openLightbox(index) {
      if (!lightbox || !photos[index]) return;
      lightboxIndex = index;
      lightboxImg.src = photos[index];
      lightboxImg.alt = items[index]?.querySelector('img')?.alt || '';
      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      updateLightboxUI();
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.hidden = true;
      document.body.style.overflow = '';
    }

    function lightboxNav(dir) {
      const newIndex = lightboxIndex + dir;
      if (newIndex >= 0 && newIndex < photos.length) {
        openLightbox(newIndex);
      }
    }

    function updateLightboxUI() {
      if (lightboxCount) lightboxCount.textContent = `${lightboxIndex + 1} / ${photos.length}`;
      if (lightboxPrev) lightboxPrev.style.visibility = lightboxIndex <= 0 ? 'hidden' : 'visible';
      if (lightboxNext) lightboxNext.style.visibility = lightboxIndex >= photos.length - 1 ? 'hidden' : 'visible';
    }

    // Click on gallery images opens lightbox
    items.forEach((item, i) => {
      const img = item.querySelector('img');
      img?.addEventListener('click', (e) => {
        e.stopPropagation();
        openLightbox(i);
      });
    });

    lightboxClose?.addEventListener('click', closeLightbox);
    lightboxBg?.addEventListener('click', closeLightbox);
    lightboxPrev?.addEventListener('click', () => lightboxNav(-1));
    lightboxNext?.addEventListener('click', () => lightboxNav(1));

    // Keyboard
    document.addEventListener('keydown', (e) => {
      if (lightbox && !lightbox.hidden) {
        if (e.key === 'Escape') { closeLightbox(); return; }
        if (e.key === 'ArrowLeft') { e.preventDefault(); lightboxNav(-1); return; }
        if (e.key === 'ArrowRight') { e.preventDefault(); lightboxNav(1); return; }
      }
      if (e.key === 'ArrowLeft' && !isMobile) { e.preventDefault(); scrollBy(-1); }
      if (e.key === 'ArrowRight' && !isMobile) { e.preventDefault(); scrollBy(1); }
    });

    update();
  })();
</script>

<style>
  .project-page {
    padding: 0;
    display: flex;
    flex-direction: column;
    height: calc(100vh - 150px);
    overflow: hidden;
  }

  /* ---- Text Card in Gallery ---- */

  .gallery-text-card {
    flex-shrink: 0;
    width: 380px;
    max-width: 80vw;
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    scroll-snap-align: center;
  }

  .gallery-text-card h1 {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    margin: 0 0 12px;
    font-family: var(--font-heading);
  }

  .gallery-text-card p {
    font-size: 16px;
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }

  /* ---- Horizontal Scroll Gallery ---- */

  .gallery-scroll {
    flex: 1;
    overflow-x: auto;
    overflow-y: hidden;
    position: relative;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    min-height: 0;
  }

  .gallery-scroll::-webkit-scrollbar {
    display: none;
  }

  .gallery-track {
    display: flex;
    height: 100%;
    align-items: flex-start;
    padding: 0 36px;
    gap: 0;
    width: max-content;
  }

  .gallery-item {
    flex-shrink: 0;
    height: 70vh;
    max-height: 700px;
    scroll-snap-align: center;
    padding: 0 20px 20px;
    display: flex;
    align-items: center;
  }

  .gallery-item img,
  .gallery-item picture img {
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .gallery-item img.is-loaded,
  .gallery-item picture img.is-loaded {
    opacity: 1;
  }

  .gallery-item picture {
    display: contents;
  }

  .gallery-image-bg {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: auto;
  }

  .gallery-image-bg img,
  .gallery-item > img {
    height: 100%;
    width: auto;
    max-width: 90vw;
    object-fit: contain;
  }

  .gallery-video {
    flex-shrink: 0;
    height: 70vh;
    max-height: 700px;
    scroll-snap-align: center;
    padding: 0 20px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gallery-video iframe {
    height: 100%;
    aspect-ratio: 16/9;
    max-width: 90vw;
    border: none;
  }

  /* ---- Progress Bar ---- */

  .gallery-progress {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: rgba(0,0,0,0.06);
  }

  .gallery-progress-bar {
    height: 100%;
    background: var(--muted);
    width: 0%;
    transition: width 0.1s linear;
  }

  /* ---- Responsive ---- */

  @media (max-width: 768px) {
    .project-page {
      height: auto;
    }

    .gallery-scroll {
      overflow: visible;
      scroll-snap-type: none;
    }

    .gallery-track {
      flex-direction: column;
      width: 100%;
      padding: 0;
      align-items: stretch;
    }

    .gallery-item:first-of-type {
      margin-top: 50px;
    }

    .gallery-item {
      width: 100%;
      height: auto;
      max-height: none;
      padding: 0 0 30px;
      scroll-snap-align: none;
    }

    .gallery-item img,
    .gallery-item picture img {
      width: 100%;
      height: auto;
      max-width: 100%;
      display: block;
      object-fit: contain;
      opacity: 0;
      transition: opacity 0.4s ease;
    }

    .gallery-item img.is-loaded,
    .gallery-item picture img.is-loaded {
      opacity: 1;
    }

    .gallery-image-bg {
      width: 100%;
      height: auto;
    }

    .gallery-video {
      width: 100%;
      height: auto;
      padding: 0;
    }

    .gallery-video iframe {
      width: 100%;
      height: 56.25vw;
      max-width: 100%;
    }

    .gallery-text-card {
      width: 100%;
      max-width: 100%;
      padding: 24px 16px;
      scroll-snap-align: none;
    }

    .gallery-progress {
      display: none;
    }
  }

  /* ---- Lightbox ---- */

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.92);
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-bg {
    position: absolute;
    inset: 0;
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 24px;
    z-index: 10;
    background: none;
    border: none;
    color: #fff;
    font-size: 36px;
    cursor: pointer;
    opacity: 0.7;
    line-height: 1;
    padding: 8px;
  }

  .lightbox-close:hover {
    opacity: 1;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: none;
    border: none;
    cursor: pointer;
    padding: 12px;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .lightbox-nav:hover {
    opacity: 1;
  }

  .lightbox-nav img {
    display: block;
  }

  .lightbox-prev {
    left: 20px;
  }

  .lightbox-next {
    right: 20px;
  }

  .lightbox-image-wrap {
    max-width: 90vw;
    max-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-image-wrap img {
    max-width: 90vw;
    max-height: 85vh;
    object-fit: contain;
  }

  .lightbox-counter {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.6);
    font-size: 14px;
  }
</style>