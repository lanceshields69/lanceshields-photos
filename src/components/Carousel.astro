---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
}
const { images } = Astro.props;
---

<div class="carousel" id="home-carousel">
  <div class="carousel-track">
    {images.map((img, i) => (
      <div class="carousel-slide" class:list={[{ active: i === 0 }]}>
        <Image
          src={img}
          alt=""
          widths={[400, 800, 1200, 1600, 2000]}
          sizes="(max-width: 768px) 100vw, 80vw"
          format="avif"
          quality={85}
          loading={i === 0 ? 'eager' : 'lazy'}
        />
      </div>
    ))}
    <button class="carousel-side-arrow carousel-prev" id="carousel-prev" aria-label="Previous">
      <img src="/images/left-arrow.svg" alt="" width="17" height="30" />
    </button>
    <button class="carousel-side-arrow carousel-next" id="carousel-next" aria-label="Next">
      <img src="/images/right-arrow.svg" alt="" width="17" height="30" />
    </button>
  </div>

  <div class="carousel-thumbs" id="carousel-thumbs">
    {images.map((img, i) => (
      <button
        type="button"
        class="carousel-thumb"
        class:list={[{ active: i === 0 }]}
        data-index={i}
        aria-label={`Slide ${i + 1}`}
      >
        <Image src={img} alt="" width={60} height={60} format="avif" quality={85} loading="lazy" />
      </button>
    ))}
  </div>
</div>

<script>
  (function () {
    const carousel = document.getElementById('home-carousel');
    if (!carousel) return;
    const slides = carousel.querySelectorAll('.carousel-slide');
    const thumbs = carousel.querySelectorAll('.carousel-thumb');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    const thumbsContainer = document.getElementById('carousel-thumbs');
    let current = 0;
    const interval = 3000;
    let timer;

    function goTo(index) {
      slides[current].classList.remove('active');
      thumbs[current].classList.remove('active');
      current = (index + slides.length) % slides.length;
      slides[current].classList.add('active');
      thumbs[current].classList.add('active');
      // Scroll thumbnail into view
      thumbs[current]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }

    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }
    function start() { clearInterval(timer); timer = setInterval(next, interval); }
    start();

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => { goTo(Number(thumb.dataset.index)); start(); });
    });
    prevBtn?.addEventListener('click', () => { prev(); start(); });
    nextBtn?.addEventListener('click', () => { next(); start(); });
  })();
</script>

<style>
  .carousel {
    position: relative;
    width: 100%;
  }

  .carousel-track {
    position: relative;
    width: 100%;
    height: 800px;
    background: var(--bg-page);
  }

  .carousel-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-slide.active {
    opacity: 1;
  }

  .carousel-slide img {
    max-width: 1208px;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* Side arrows */
  .carousel-side-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: auto;
    height: auto;
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .carousel-side-arrow:hover {
    opacity: 1;
  }

  .carousel-prev {
    left: 22px;
  }

  .carousel-next {
    right: 22px;
  }

  /* Thumbnail strip */
  .carousel-thumbs {
    display: flex;
    gap: 4px;
    padding: 4px 0 0;
    overflow-x: auto;
    justify-content: center;
    -webkit-overflow-scrolling: touch;
  }

  .carousel-thumbs::-webkit-scrollbar {
    display: none;
  }

  .carousel-thumb {
    width: 66px;
    height: 66px;
    flex-shrink: 0;
    border: 2px solid transparent;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    background: #f0efe9;
    transition: border-color 0.2s;
  }

  .carousel-thumb.active {
    border-color: #000;
  }

  .carousel-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .carousel-track {
      height: auto;
    }

    .carousel-slide {
      position: relative;
      height: 0;
      overflow: hidden;
      padding: 0;
    }

    .carousel-slide.active {
      position: relative;
      height: auto;
      background: var(--bg-page);
    }

    .carousel-slide img {
      width: 100%;
      height: auto;
      max-height: none;
      display: block;
    }

    .carousel-thumb {
      width: 53px;
      height: 53px;
    }

    .carousel-thumbs {
      justify-content: flex-start;
      padding-left: 20px;
    }
  }
</style>
</style>